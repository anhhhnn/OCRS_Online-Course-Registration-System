@model ClassSchedule
@{ViewData["Title"]="Thêm lịch học";}<div class="row"><div class="col-lg-6"><div class="form-card"><h1 class="h3">Thêm lịch học</h1><form method="post"><input asp-for="ClassId" type="hidden"><div asp-validation-summary="ModelOnly"></div><label asp-for="DayOfWeek">Thứ</label><select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select mb-3"></select><div class="row"><div class="col"><label asp-for="StartTime">Bắt đầu</label><input asp-for="StartTime" class="form-control"></div><div class="col"><label asp-for="EndTime">Kết thúc</label><input asp-for="EndTime" class="form-control"></div></div><label asp-for="RoomOrLink" class="mt-3">Phòng hoặc link</label><input asp-for="RoomOrLink" class="form-control mb-3"><button class="btn btn-primary">Lưu lịch</button></form></div></div></div>
