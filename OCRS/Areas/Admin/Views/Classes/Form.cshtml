@model CourseClass
@{ViewData["Title"]=Model.ClassId==0?"Mở lớp mới":"Sửa lớp";}<div class="form-card"><h1 class="h3">@ViewData["Title"]</h1><form method="post"><input asp-for="ClassId" type="hidden"><div asp-validation-summary="ModelOnly"></div><div class="row g-3"><div class="col-md-3"><label asp-for="ClassCode">Mã lớp</label><input asp-for="ClassCode" class="form-control"></div><div class="col-md-5"><label asp-for="ClassName">Tên lớp</label><input asp-for="ClassName" class="form-control"></div><div class="col-md-4"><label asp-for="CourseId">Khóa học</label><select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select"></select></div><div class="col-md-4"><label asp-for="InstructorId">Giảng viên</label><select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="form-select"><option value="">Chưa phân công</option></select></div><div class="col-md-4"><label asp-for="MaxCapacity">Sĩ số tối đa</label><input asp-for="MaxCapacity" class="form-control"></div><div class="col-md-4"><label asp-for="Status">Trạng thái</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ClassStatus>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="StartDate">Ngày bắt đầu</label><input asp-for="StartDate" class="form-control"></div><div class="col-md-3"><label asp-for="EndDate">Ngày kết thúc</label><input asp-for="EndDate" class="form-control"></div><div class="col-md-3"><label asp-for="RegistrationOpenAt">Mở đăng ký</label><input asp-for="RegistrationOpenAt" class="form-control"></div><div class="col-md-3"><label asp-for="RegistrationCloseAt">Đóng đăng ký</label><input asp-for="RegistrationCloseAt" class="form-control"></div><div class="col-md-4"><label asp-for="LearningMode">Hình thức</label><select asp-for="LearningMode" asp-items="Html.GetEnumSelectList<LearningMode>()" class="form-select"></select></div><div class="col-md-5"><label asp-for="Location">Địa điểm</label><input asp-for="Location" class="form-control"></div><div class="col-md-3 d-flex align-items-end"><label><input asp-for="RequiresApproval"> Cần duyệt</label></div></div><button class="btn btn-primary mt-4">Lưu lớp học</button></form></div>
