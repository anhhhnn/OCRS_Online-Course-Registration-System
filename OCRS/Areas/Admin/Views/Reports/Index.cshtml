@model IEnumerable<ReportRow>
@{ViewData["Title"]="Báo cáo";}<div class="section-heading"><h1>Báo cáo đăng ký</h1><a class="btn btn-success" href="/Admin/Reports/Csv@Context.Request.QueryString">Xuất CSV</a></div><form class="form-card mb-3"><div class="row g-2"><div class="col-md-3"><label>Từ ngày</label><input name="from" type="date" class="form-control"></div><div class="col-md-3"><label>Đến ngày</label><input name="to" type="date" class="form-control"></div><div class="col-md-3"><label>Trạng thái</label><select name="status" asp-items="Html.GetEnumSelectList<EnrollmentStatus>()" class="form-select"><option value="">Tất cả</option></select></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Áp dụng</button></div></div></form><div class="table-card p-0 overflow-auto"><table class="table mb-0"><thead><tr><th>Học viên</th><th>Khóa học</th><th>Lớp</th><th>Trạng thái</th><th>Ngày</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.StudentName<br><small>@r.StudentCode · @r.Email</small></td><td>@r.Course</td><td>@r.Class</td><td>@r.Status</td><td>@r.RegisteredAt.ToLocalTime().ToString("dd/MM/yyyy")</td></tr>}</tbody></table></div>
