@model OCRS.ViewModels.Admin.ClassFormViewModel
@{ ViewData["Title"] = Model.ClassId == 0 ? "Mở lớp mới" : "Sửa lớp"; }
<div class="section-heading"><div><span class="section-kicker">QUẢN LÝ LỚP HỌC</span><h1>@ViewData["Title"]</h1></div><a asp-action="Index" class="btn btn-light">Quay lại danh sách</a></div>
<div class="form-card admin-class-form"><form method="post" data-loading-form>
    @Html.AntiForgeryToken()<input asp-for="ClassId" type="hidden" /><input asp-for="RowVersion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-summary alert alert-danger" role="alert"></div>
    <div class="row g-4">
        <div class="col-md-3"><label asp-for="ClassCode"></label><input asp-for="ClassCode" class="form-control" /><span asp-validation-for="ClassCode"></span></div>
        <div class="col-md-5"><label asp-for="ClassName"></label><input asp-for="ClassName" class="form-control" /><span asp-validation-for="ClassName"></span></div>
        <div class="col-md-4"><label asp-for="CourseId"></label><select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select"><option value="0">-- Chọn khóa học --</option></select><span asp-validation-for="CourseId"></span></div>
        <div class="col-md-4"><label asp-for="InstructorId"></label><select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="form-select"><option value="">Chưa phân công</option></select><span asp-validation-for="InstructorId"></span></div>
        <div class="col-md-4"><label asp-for="MaxCapacity"></label><input asp-for="MaxCapacity" class="form-control" min="1" max="1000" /><span asp-validation-for="MaxCapacity"></span></div>
        <div class="col-md-4"><label asp-for="Status"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ClassStatus>()" class="form-select"></select></div>
        <div class="col-md-3"><label asp-for="StartDate"></label><input asp-for="StartDate" class="form-control" /><span asp-validation-for="StartDate"></span></div>
        <div class="col-md-3"><label asp-for="EndDate"></label><input asp-for="EndDate" class="form-control" /><span asp-validation-for="EndDate"></span></div>
        <div class="col-md-3"><label asp-for="RegistrationOpenAt"></label><input asp-for="RegistrationOpenAt" class="form-control" /><span asp-validation-for="RegistrationOpenAt"></span></div>
        <div class="col-md-3"><label asp-for="RegistrationCloseAt"></label><input asp-for="RegistrationCloseAt" class="form-control" /><span asp-validation-for="RegistrationCloseAt"></span></div>
        <div class="col-md-4"><label asp-for="LearningMode"></label><select asp-for="LearningMode" asp-items="Html.GetEnumSelectList<LearningMode>()" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="Location"></label><input asp-for="Location" class="form-control" placeholder="Cơ sở / phòng học" /><span asp-validation-for="Location"></span></div>
        <div class="col-md-4"><label asp-for="MeetingLink"></label><input asp-for="MeetingLink" class="form-control" placeholder="https://..." /><span asp-validation-for="MeetingLink"></span></div>
        <div class="col-12"><label class="check-control"><input asp-for="RequiresApproval" /><span></span>Cần quản trị viên duyệt đăng ký</label></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" type="submit"><span class="button-label">Lưu lớp học</span><span class="button-loader" aria-hidden="true"></span></button><a asp-action="Index" class="btn btn-light">Hủy</a></div>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
