@model IEnumerable<Enrollment>
@{ ViewData["Title"] = "Lớp học của tôi"; var activeCount = Model.Count(e => e.Status is EnrollmentStatus.Pending or EnrollmentStatus.Approved); }
<header class="dashboard-hero reveal"><div><span class="eyebrow"><i></i> KHÔNG GIAN HỌC VIÊN</span><h1>Xin chào,<br /><em>@(User.Identity?.Name?.Split('@')[0] ?? "bạn").</em></h1><p>Mọi lớp học và trạng thái đăng ký của bạn được tập trung tại đây.</p></div><div class="dashboard-stat"><span>Đang theo học</span><strong>@activeCount.ToString("00")</strong><small>lớp đang hoạt động</small></div></header>
@if (!Model.Any()) { <div class="empty-state reveal"><span class="empty-symbol">01</span><h2>Hành trình của bạn đang chờ bắt đầu</h2><p>Khám phá các khóa học đang tuyển sinh và chọn một lớp phù hợp với lịch của bạn.</p><a href="/Courses" class="btn btn-primary">Khám phá khóa học <span>→</span></a></div> }
else
{
    <div class="enrollment-list">@foreach (var enrollment in Model) { var statusText = enrollment.Status switch { EnrollmentStatus.Pending => "Chờ duyệt", EnrollmentStatus.Approved => "Đã xác nhận", EnrollmentStatus.Rejected => "Bị từ chối", EnrollmentStatus.Cancelled => "Đã hủy", _ => "Đã hoàn thành" }; <article class="enrollment-card reveal"><div class="enrollment-index">@((Model.ToList().IndexOf(enrollment) + 1).ToString("00"))</div><div class="enrollment-main"><div class="enrollment-meta"><span class="badge-soft status-@enrollment.Status.ToString().ToLowerInvariant()">@statusText</span><small>Đăng ký @enrollment.RegisteredAt.ToLocalTime().ToString("dd/MM/yyyy")</small></div><h2>@enrollment.Class.ClassName</h2><p>@enrollment.Class.Course.CourseName</p><div class="schedule-chips">@foreach (var schedule in enrollment.Class.Schedules) { <span>@schedule.DayOfWeek · @schedule.StartTime.ToString("HH:mm")—@schedule.EndTime.ToString("HH:mm")</span> }</div></div><div class="enrollment-actions"><a class="arrow-link" href="/Classes/Details/@enrollment.ClassId">Xem lớp <span>→</span></a>@if (enrollment.Status is EnrollmentStatus.Pending or EnrollmentStatus.Approved) { <form action="/Enrollments/Cancel/@enrollment.EnrollmentId" method="post" data-confirm="Bạn chắc chắn muốn hủy đăng ký lớp này?">@Html.AntiForgeryToken()<button class="btn btn-link text-danger">Hủy đăng ký</button></form> }</div></article> }</div>
}
