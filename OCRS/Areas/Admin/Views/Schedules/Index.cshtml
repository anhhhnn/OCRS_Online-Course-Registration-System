@model IEnumerable<ClassSchedule>
@{ViewData["Title"]="Lịch học";}<div class="section-heading"><h1>Lịch học</h1><a class="btn btn-primary" href="/Admin/Schedules/Create?classId=@ViewBag.ClassId">Thêm lịch</a></div><div class="table-card"><table class="table"><thead><tr><th>Thứ</th><th>Thời gian</th><th>Phòng/Link</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.DayOfWeek</td><td>@x.StartTime.ToString("HH:mm")–@x.EndTime.ToString("HH:mm")</td><td>@x.RoomOrLink</td><td><form method="post" action="/Admin/Schedules/Delete/@x.ScheduleId">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table></div>
