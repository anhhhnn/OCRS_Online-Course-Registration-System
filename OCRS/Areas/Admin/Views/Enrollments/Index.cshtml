@model IEnumerable<Enrollment>
@{ViewData["Title"]="Quản lý đăng ký";}<h1>Đăng ký lớp học</h1><form class="my-3"><select name="status" asp-items="Html.GetEnumSelectList<EnrollmentStatus>()" class="form-select" style="max-width:260px" onchange="this.form.submit()"><option value="">Mọi trạng thái</option></select></form><div class="table-card p-0 overflow-auto"><table class="table mb-0"><thead><tr><th>Học viên</th><th>Lớp</th><th>Ngày đăng ký</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Student.User.FullName<br><small>@e.Student.StudentCode</small></td><td>@e.Class.ClassName<br><small>@e.Class.Course.CourseName</small></td><td>@e.RegisteredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@e.Status</td><td>@if(e.Status==EnrollmentStatus.Pending){<form method="post" action="/Admin/Enrollments/Approve/@e.EnrollmentId" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Duyệt</button></form><form method="post" action="/Admin/Enrollments/Reject/@e.EnrollmentId" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Từ chối</button></form>}</td></tr>}</tbody></table></div>
