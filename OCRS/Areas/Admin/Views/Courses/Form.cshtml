@model Course
@{ViewData["Title"]=Model.CourseId==0?"Thêm khóa học":"Sửa khóa học";}<div class="form-card"><h1 class="h3">@ViewData["Title"]</h1><form method="post"><input asp-for="CourseId" type="hidden"><div asp-validation-summary="ModelOnly"></div><div class="row g-3"><div class="col-md-3"><label asp-for="CourseCode">Mã khóa</label><input asp-for="CourseCode" class="form-control"><span asp-validation-for="CourseCode"></span></div><div class="col-md-6"><label asp-for="CourseName">Tên khóa học</label><input asp-for="CourseName" class="form-control"></div><div class="col-md-3"><label asp-for="CategoryId">Danh mục</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select></div><div class="col-12"><label asp-for="Description">Mô tả</label><textarea asp-for="Description" class="form-control"></textarea></div><div class="col-12"><label asp-for="Objectives">Mục tiêu</label><textarea asp-for="Objectives" class="form-control"></textarea></div><div class="col-md-3"><label asp-for="Duration">Thời lượng (giờ)</label><input asp-for="Duration" class="form-control"></div><div class="col-md-3"><label asp-for="TuitionFee">Học phí</label><input asp-for="TuitionFee" class="form-control"></div><div class="col-md-3"><label asp-for="LearningMode">Hình thức</label><select asp-for="LearningMode" asp-items="Html.GetEnumSelectList<LearningMode>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="Status">Trạng thái</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<CourseStatus>()" class="form-select"></select></div></div><button class="btn btn-primary mt-4">Lưu khóa học</button></form></div>
