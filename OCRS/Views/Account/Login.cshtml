@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<section class="auth-shell">
    <div class="auth-visual"><img src="~/images/ocrs-learning-hero.jpg" alt="Học viên trao đổi trong không gian học tập hiện đại" width="1800" height="1200" /><div class="auth-visual-overlay"><a class="brand brand-light" href="/"><span class="brand-symbol" aria-hidden="true"><span></span></span><span><strong>OCRS</strong><small>Learning Experience</small></span></a><div><span class="eyebrow eyebrow-light"><i></i> HỌC TẬP CÓ MỤC TIÊU</span><blockquote>“Mỗi ngôn ngữ mới là một cách mới để nhìn thế giới.”</blockquote><p>Trở lại hành trình của bạn, theo cách tập trung và liền mạch hơn.</p></div></div></div>
    <div class="auth-panel"><div class="auth-form-wrap reveal"><a class="auth-back" href="/">← Về trang chủ</a><span class="auth-step">THÀNH VIÊN OCRS</span><h1>Chào mừng<br />bạn quay lại.</h1><p>Đăng nhập để tiếp tục quản lý lớp học và theo dõi hành trình của bạn.</p><form method="post" data-loading-form><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="field"><label asp-for="Email">Địa chỉ email</label><input asp-for="Email" autocomplete="email" placeholder="ban@example.com" /><span asp-validation-for="Email"></span></div><div class="field password-field"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" /><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><span aria-hidden="true">Hiện</span></button><span asp-validation-for="Password"></span></div><div class="form-options"><label class="check-control"><input asp-for="RememberMe" /><span></span>Ghi nhớ đăng nhập</label><a href="/Account/ForgotPassword">Quên mật khẩu?</a></div><button class="btn btn-primary btn-lg w-100" type="submit"><span class="button-label">Đăng nhập</span><span class="button-loader" aria-hidden="true"></span></button></form><p class="auth-switch">Chưa có tài khoản? <a href="/Account/Register">Tạo tài khoản học viên</a></p>@if (TempData["DevResetLink"] != null) { <div class="alert alert-info mt-3 text-break">Development reset link: <a href="@TempData["DevResetLink"]">Đặt lại mật khẩu</a></div> }</div></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
