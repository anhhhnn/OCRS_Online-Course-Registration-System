@model OCRS.ViewModels.Catalog.ClassDetailsViewModel
@{var item=Model.Class;ViewData["Title"]=item.ClassName;var now=DateTime.UtcNow;var isFull=Model.Remaining==0;var isBefore=now<item.RegistrationOpenAt;var isOpen=item.Status==ClassStatus.OpenForRegistration&&item.RegistrationOpenAt<=now&&item.RegistrationCloseAt>=now;var statusText=isFull?"Đã hết chỗ":isBefore?"Chưa mở đăng ký":item.Status==ClassStatus.OpenForRegistration&&now>item.RegistrationCloseAt?"Đã đóng đăng ký":item.Status==ClassStatus.OpenForRegistration?"Đang tuyển sinh":item.Status switch{ClassStatus.Draft=>"Sắp mở",ClassStatus.Closed=>"Đã đóng",ClassStatus.InProgress=>"Đang học",ClassStatus.Completed=>"Đã hoàn thành",_=>"Đã hủy"};var modeText=item.LearningMode switch{LearningMode.Online=>"Trực tuyến",LearningMode.Offline=>"Tại trung tâm",_=>"Kết hợp"};var active=Model.Enrollment?.Status is EnrollmentStatus.Pending or EnrollmentStatus.Approved;}
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><a href="/Courses">Khóa học</a><span>/</span><a href="/Courses/Details/@item.CourseId#classes">@item.Course.CourseName</a><span>/</span><span>@item.ClassName</span></nav>
<header class="class-header reveal"><div><span class="eyebrow"><i></i> @item.ClassCode</span><h1>@item.ClassName</h1><p>@item.Course.CourseName</p></div><div class="class-header-status"><span class="badge-soft">@statusText</span><span class="badge-soft">@modeText</span></div></header>
<div class="detail-layout class-detail-layout"><div class="detail-main">
    <section class="content-block reveal"><span class="section-kicker">THÔNG TIN LỚP</span><h2>Mọi điều bạn cần biết</h2><dl class="info-grid"><div><dt>Giảng viên</dt><dd>@(item.Instructor?.User.FullName??"Đang cập nhật")</dd></div><div><dt>Thời gian</dt><dd>@item.StartDate.ToString("dd/MM/yyyy") — @item.EndDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Hình thức</dt><dd>@modeText</dd></div><div><dt>Địa điểm</dt><dd>@(item.LearningMode==LearningMode.Online?(item.MeetingLink??"Cung cấp sau khi xác nhận"):(item.Location??"Đang cập nhật"))</dd></div></dl></section>
    <section class="content-block reveal"><span class="section-kicker">LỊCH HỌC</span><h2>Thời khóa biểu</h2>@if(!item.Schedules.Any()){<p class="text-secondary">Lịch học chi tiết đang được cập nhật.</p>}else{<div class="schedule-list">@foreach(var s in item.Schedules.OrderBy(x=>x.DayOfWeek)){<div><span>@s.DayOfWeek</span><strong>@s.StartTime.ToString("HH:mm") — @s.EndTime.ToString("HH:mm")</strong><small>@s.RoomOrLink</small></div>}</div>}</section>
    <a class="arrow-link" href="/Courses/Details/@item.CourseId#classes">← Quay lại các lớp của khóa học</a>
    </div><aside class="registration-card class-register-card reveal @(active?"is-registered":null)"><span class="section-kicker">TÌNH TRẠNG ĐĂNG KÝ</span>
        @if(Model.Enrollment?.Status==EnrollmentStatus.Approved){<div class="registration-success-icon">✓</div><h2>Đã đăng ký</h2><p>Chỗ học của bạn đã được xác nhận trong lớp này.</p><a class="btn btn-outline-primary w-100" href="/MyCourses">Xem lớp học của tôi</a>}
        else if(Model.Enrollment?.Status==EnrollmentStatus.Pending){<div class="registration-success-icon pending">…</div><h2>Đang chờ duyệt</h2><p>Yêu cầu đã được tiếp nhận. Chúng tôi sẽ thông báo khi quản trị viên duyệt.</p><a class="btn btn-outline-primary w-100" href="/MyCourses">Xem lớp học của tôi</a>}
        else{<div class="seat-count">@Model.Remaining</div><p>chỗ còn lại trên tổng số @item.MaxCapacity · @statusText</p><div class="capacity-track"><span style="width:@Model.FilledPercent%"></span></div>
            @if(User.Identity?.IsAuthenticated==true&&User.IsInRole("Student")){<form action="/Enrollments/Register" method="post" data-loading-form>@Html.AntiForgeryToken()<input type="hidden" name="classId" value="@item.ClassId"/><button type="submit" class="btn btn-primary btn-lg w-100" disabled="@(!isOpen||isFull?"disabled":null)"><span class="button-label">@(!isOpen||isFull?statusText:Model.Enrollment is null?"Đăng ký lớp này":"Đăng ký lại")</span><span class="button-loader" aria-hidden="true"></span></button></form>}
            else if(User.Identity?.IsAuthenticated!=true){<a class="btn btn-primary btn-lg w-100 @(!isOpen||isFull?"disabled":null)" href="@(!isOpen||isFull?null:$"/Account/Login?returnUrl=/Classes/Details/{item.ClassId}")" aria-disabled="@(!isOpen||isFull?"true":null)">@(!isOpen||isFull?statusText:"Đăng nhập để đăng ký")</a>}
            <small class="secure-note">Số chỗ chỉ được ghi nhận sau khi hệ thống lưu đăng ký thành công.</small>}
    </aside></div>
<section class="other-classes reveal"><div class="content-title"><div><span class="section-kicker">CÙNG KHÓA HỌC</span><h2>Các lớp khác thuộc khóa học này</h2></div></div>@if(!Model.OtherClasses.Any()){<div class="inline-empty"><h3>Chưa có lớp khác</h3><p>Danh sách lớp mới sẽ được cập nhật tại đây.</p></div>}else{<div class="other-class-grid">@foreach(var other in Model.OtherClasses){<article><span>@other.ClassCode</span><h3>@other.ClassName</h3><p>@other.StartDate.ToString("dd/MM/yyyy") · @(other.Instructor?.User.FullName??"Đang cập nhật")</p><a href="/Classes/Details/@other.ClassId">Xem chi tiết →</a></article>}</div>}</section>
