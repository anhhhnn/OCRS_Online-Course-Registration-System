@model IEnumerable<CourseClass>
@{ViewData["Title"]="Quản lý lớp";}<div class="section-heading"><h1>Lớp học</h1><a href="/Admin/Classes/Create" class="btn btn-primary">Mở lớp mới</a></div><div class="table-card p-0 overflow-auto"><table class="table mb-0"><thead><tr><th>Mã</th><th>Lớp</th><th>Giảng viên</th><th>Sĩ số</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ClassCode</td><td>@x.ClassName<br><small>@x.Course.CourseName</small></td><td>@x.Instructor?.User.FullName</td><td>@x.CurrentEnrollment / @x.MaxCapacity</td><td>@x.Status</td><td><a class="btn btn-sm btn-outline-primary" href="/Admin/Classes/Edit/@x.ClassId">Sửa</a> <a class="btn btn-sm btn-outline-secondary" href="/Admin/Schedules?classId=@x.ClassId">Lịch</a></td></tr>}</tbody></table></div>
