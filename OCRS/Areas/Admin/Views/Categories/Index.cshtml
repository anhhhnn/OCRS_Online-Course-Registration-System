@model IEnumerable<Category>
@{ViewData["Title"]="Danh mục";}<div class="section-heading"><h1>Danh mục</h1><a href="/Admin/Categories/Create" class="btn btn-primary">Thêm mới</a></div><form class="mb-3 d-flex gap-2"><input name="q" class="form-control" placeholder="Tìm danh mục"><select name="active" class="form-select" style="max-width:200px"><option value="">Mọi trạng thái</option><option value="true">Đang dùng</option><option value="false">Ngừng dùng</option></select><button class="btn btn-outline-primary">Lọc</button></form><div class="table-card p-0 overflow-hidden"><table class="table mb-0"><thead><tr><th>Tên</th><th>Mô tả</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CategoryName</td><td>@x.Description</td><td>@(x.IsActive?"Đang dùng":"Ngừng dùng")</td><td class="text-end"><a href="/Admin/Categories/Edit/@x.CategoryId" class="btn btn-sm btn-outline-primary">Sửa</a><form method="post" action="/Admin/Categories/Toggle/@x.CategoryId" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary">@(x.IsActive?"Vô hiệu":"Kích hoạt")</button></form></td></tr>}</tbody></table></div>
