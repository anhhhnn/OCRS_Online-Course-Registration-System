@model IEnumerable<SyncLog>
@{ViewData["Title"]="Đồng bộ CRM";}<div class="section-heading"><div><h1>Đồng bộ CRM mô phỏng</h1><p class="text-secondary mb-0">Adapter minh họa, không kết nối CRM thật.</p></div><form method="post" action="/Admin/Crm/Sync">@Html.AntiForgeryToken()<button class="btn btn-primary">Nhập dữ liệu mẫu</button></form></div><div class="table-card p-0"><table class="table mb-0"><thead><tr><th>Mã ngoài</th><th>Kết quả</th><th>Thông điệp</th><th>Thời gian</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ExternalId</td><td>@x.Status</td><td>@x.Message</td><td>@x.SyncedAt.ToLocalTime()</td></tr>}</tbody></table></div>
