@model Category
@{ViewData["Title"]=Model.CategoryId==0?"Thêm danh mục":"Sửa danh mục";}<div class="row"><div class="col-lg-7"><div class="form-card"><h1 class="h3">@ViewData["Title"]</h1><form method="post"><input asp-for="CategoryId" type="hidden"><div asp-validation-summary="ModelOnly"></div><div class="mb-3"><label asp-for="CategoryName">Tên danh mục</label><input asp-for="CategoryName" class="form-control"><span asp-validation-for="CategoryName"></span></div><div class="mb-3"><label asp-for="Description">Mô tả</label><textarea asp-for="Description" class="form-control"></textarea></div><label class="mb-3"><input asp-for="IsActive"> Đang hoạt động</label><br><button class="btn btn-primary">Lưu</button> <a href="/Admin/Categories" class="btn btn-light">Hủy</a></form></div></div></div>
