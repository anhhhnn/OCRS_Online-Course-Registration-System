@model IEnumerable<Course>
@{ViewData["Title"]="Quản lý khóa học";}<div class="section-heading"><h1>Khóa học</h1><a href="/Admin/Courses/Create" class="btn btn-primary">Thêm khóa học</a></div><form class="mb-3 d-flex gap-2"><input name="q" class="form-control" placeholder="Tên hoặc mã khóa học"><button class="btn btn-outline-primary">Tìm</button></form><div class="table-card p-0 overflow-auto"><table class="table mb-0"><thead><tr><th>Mã</th><th>Khóa học</th><th>Danh mục</th><th>Học phí</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CourseCode</td><td>@x.CourseName</td><td>@x.Category.CategoryName</td><td>@x.TuitionFee.ToString("N0") đ</td><td>@x.Status</td><td><a class="btn btn-sm btn-outline-primary" href="/Admin/Courses/Edit/@x.CourseId">Sửa</a></td></tr>}</tbody></table></div>
