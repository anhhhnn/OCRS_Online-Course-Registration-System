@model RegisterViewModel
@{ ViewData["Title"] = "Tạo tài khoản học viên"; }
<section class="auth-shell auth-register">
    <div class="auth-visual"><img src="~/images/ocrs-learning-hero.jpg" alt="Nhóm sinh viên học tập và trao đổi cùng nhau" width="1800" height="1200" /><div class="auth-visual-overlay"><a class="brand brand-light" href="/"><span class="brand-symbol" aria-hidden="true"><span></span></span><span><strong>OCRS</strong><small>Learning Experience</small></span></a><div><span class="eyebrow eyebrow-light"><i></i> BẮT ĐẦU TỪ HÔM NAY</span><blockquote>Hành trình mới.<br />Nhịp học của riêng bạn.</blockquote><p>Tìm chương trình, chọn lịch phù hợp và đăng ký trong một trải nghiệm rõ ràng.</p></div></div></div>
    <div class="auth-panel"><div class="auth-form-wrap auth-register-form reveal"><a class="auth-back" href="/">← Về trang chủ</a><span class="auth-step">TÀI KHOẢN HỌC VIÊN</span><h1>Bắt đầu hành trình<br />của bạn.</h1><p>Tạo tài khoản để đăng ký lớp và quản lý lịch học tập trung.</p>
        <form method="post" data-loading-form><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="field"><label asp-for="FullName">Họ và tên</label><input asp-for="FullName" autocomplete="name" placeholder="Nguyễn Minh Anh" /><span asp-validation-for="FullName"></span></div>
            <div class="field-row"><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" autocomplete="email" placeholder="ban@example.com" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="PhoneNumber">Số điện thoại</label><input asp-for="PhoneNumber" autocomplete="tel" placeholder="09xx xxx xxx" /><span asp-validation-for="PhoneNumber"></span></div></div>
            <div class="field-row"><div class="field password-field"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự" data-password-strength aria-describedby="password-help" /><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><span aria-hidden="true">Hiện</span></button><span asp-validation-for="Password"></span></div><div class="field password-field"><label asp-for="ConfirmPassword">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" /><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><span aria-hidden="true">Hiện</span></button><span asp-validation-for="ConfirmPassword"></span></div></div>
            <p id="password-help" class="password-help">Dùng ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p><div class="password-meter" data-password-meter><span></span><span></span><span></span><span></span><small>Độ mạnh mật khẩu</small></div>
            <button class="btn btn-primary btn-lg w-100" type="submit"><span class="button-label">Tạo tài khoản</span><span class="button-loader" aria-hidden="true"></span></button>
        </form><p class="auth-switch">Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p>
    </div></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
