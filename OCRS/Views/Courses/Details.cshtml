@model OCRS.ViewModels.Catalog.CourseDetailsViewModel
@{ var course=Model.Course; ViewData["Title"]=course.CourseName; var now=DateTime.UtcNow; var modeText=course.LearningMode switch { LearningMode.Online=>"Trực tuyến",LearningMode.Offline=>"Tại trung tâm",_=>"Kết hợp" }; }
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span>/</span><a href="/Courses">Khóa học</a><span>/</span><span>@course.CourseName</span></nav>
<section class="course-detail-hero reveal"><div class="course-detail-copy"><span class="eyebrow"><i></i> @course.Category.CategoryName.ToUpperInvariant()</span><h1>@course.CourseName</h1><p>@course.Description</p><div class="detail-tags"><span>@course.Duration giờ học</span><span>@modeText</span><span>@course.CourseCode</span></div></div><div class="detail-art course-accent-@((course.CategoryId%4)+1)" aria-hidden="true"><span>@course.CourseCode</span><i></i><i></i><small>OCRS · COURSE</small></div></section>
<section class="content-block reveal"><span class="section-kicker">VỀ KHÓA HỌC</span><h2>Bạn sẽ đạt được gì?</h2><p class="prose">@(string.IsNullOrWhiteSpace(course.Objectives)?"Nội dung và mục tiêu chi tiết đang được cập nhật.":course.Objectives)</p></section>
<section class="class-catalog reveal" id="classes" data-class-catalog>
    <div class="class-catalog-heading"><div><span class="section-kicker">LỊCH KHAI GIẢNG</span><h2>Chọn lớp học phù hợp với bạn</h2><p>Khám phá các lớp đang tuyển sinh, xem lịch học và lựa chọn lớp phù hợp với thời gian của bạn.</p></div><strong>@Model.Classes.Count lớp</strong></div>
    @if(Model.Classes.Count>1){<div class="class-filters" role="group" aria-label="Lọc lớp học"><button class="active" data-class-filter="all">Tất cả lớp</button><button data-class-filter="open">Đang mở đăng ký</button><button data-class-filter="available">Còn chỗ</button><button data-class-filter="online">Online</button><button data-class-filter="offline">Offline</button><button data-class-filter="soon">Sắp khai giảng</button></div>}
    <div class="class-card-grid">
    @foreach(var card in Model.Classes){var item=card.Class;var isWindow=item.RegistrationOpenAt<=now&&item.RegistrationCloseAt>=now;var isOpen=item.Status==ClassStatus.OpenForRegistration&&isWindow;var isFull=card.Remaining==0;var isSoon=item.Status==ClassStatus.Draft||now<item.RegistrationOpenAt;var isClosed=!isSoon&&!isOpen;var nearFull=!isFull&&card.Remaining<=Math.Max(1,(int)Math.Ceiling(item.MaxCapacity*.2));var state=isFull?"Đã đầy":isSoon?"Sắp mở":isClosed?"Đã đóng":nearFull?"Sắp đầy":"Đang tuyển sinh";var schedule=item.Schedules.OrderBy(x=>x.DayOfWeek).FirstOrDefault();var filters=$"{(isOpen?"open ":"")}{(isOpen&&!isFull?"available ":"")}{(item.LearningMode==LearningMode.Online?"online":item.LearningMode==LearningMode.Offline?"offline":"online offline")}{(item.StartDate<=now.AddDays(30)&&item.StartDate>=now?" soon":"")}";
        <article class="class-card" data-class-item="@filters"><div class="class-card-top"><div><span class="class-code">@item.ClassCode</span><h3>@item.ClassName</h3></div><span class="class-state state-@(isOpen&&!isFull?"open":isFull?"full":isSoon?"soon":"closed")">@state</span></div>
        <dl class="class-facts"><div><dt>Giảng viên</dt><dd>@(item.Instructor?.User.FullName??"Đang cập nhật")</dd></div><div><dt>Thời gian</dt><dd>@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Lịch học</dt><dd>@(schedule is null?"Đang cập nhật":$"{schedule.DayOfWeek}, {schedule.StartTime:HH:mm}–{schedule.EndTime:HH:mm}")</dd></div><div><dt>Hình thức</dt><dd>@(item.LearningMode==LearningMode.Online?"Online":item.LearningMode==LearningMode.Offline?"Offline":"Kết hợp") · @(item.Location??"Linh hoạt")</dd></div></dl>
        <div class="class-capacity"><div><span>Sĩ số</span><strong class="@(nearFull?"text-danger":null)">@card.Remaining chỗ còn lại</strong></div><div class="capacity-track"><span style="width:@card.FilledPercent%"></span></div><small>@item.CurrentEnrollment / @item.MaxCapacity học viên</small></div>
        <div class="class-card-action">@if(card.Enrollment?.Status==EnrollmentStatus.Approved){<span class="enrollment-state">✓ Đã đăng ký</span>}else if(card.Enrollment?.Status==EnrollmentStatus.Pending){<span class="enrollment-state pending">Đang chờ duyệt</span>}<a class="btn @(isOpen&&!isFull?"btn-primary":"btn-outline-primary")" href="/Classes/Details/@item.ClassId">Xem chi tiết</a></div></article>}
    </div><div class="inline-empty class-filter-empty" hidden><h3>Không có lớp phù hợp bộ lọc</h3><p>Hãy chọn một tiêu chí khác để xem thêm lớp.</p></div>
</section>
