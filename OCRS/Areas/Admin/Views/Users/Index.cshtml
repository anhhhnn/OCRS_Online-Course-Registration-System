@model IEnumerable<ApplicationUser>
@{ViewData["Title"]="Người dùng";}<h1>Người dùng</h1><form class="row g-2 my-3"><div class="col-md-6"><input name="q" class="form-control" placeholder="Tên hoặc email"></div><div class="col-md-3"><select name="role" class="form-select"><option value="">Mọi vai trò</option><option>Admin</option><option>Instructor</option><option>Student</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary">Lọc</button></div></form><div class="table-card p-0"><table class="table mb-0"><thead><tr><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.Email</td><td>@u.PhoneNumber</td><td>@(u.IsActive?"Hoạt động":"Đã khóa")</td><td><form method="post" action="/Admin/Users/Toggle/@u.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary">@(u.IsActive?"Khóa":"Mở khóa")</button></form></td></tr>}</tbody></table></div>
