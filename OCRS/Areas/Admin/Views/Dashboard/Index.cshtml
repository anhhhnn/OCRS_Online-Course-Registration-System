@model DashboardViewModel
@{ViewData["Title"]="Tổng quan quản trị";}<div class="section-heading"><div><span class="eyebrow text-primary">QUẢN TRỊ</span><h1>Tổng quan hệ thống</h1></div><span class="text-secondary">Dữ liệu cập nhật từ SQL Server</span></div><div class="row g-3">@foreach(var s in new[]{("Học viên",Model.Students.ToString()),("Giảng viên",Model.Instructors.ToString()),("Khóa học",Model.Courses.ToString()),("Lớp học",Model.Classes.ToString()),("Đăng ký",Model.Enrollments.ToString()),("Lớp đang mở",Model.OpenClasses.ToString()),("Lớp đã đầy",Model.FullClasses.ToString()),("Tỷ lệ lấp đầy",Model.FillRate+"%")} ){<div class="col-6 col-lg-3"><div class="stat-card"><div class="text-secondary small">@s.Item1</div><div class="value">@s.Item2</div></div></div>}</div><div class="row g-4 mt-1"><div class="col-lg-7"><div class="table-card"><h2 class="h5">Đăng ký theo tháng</h2><canvas id="chart" height="130"></canvas></div></div><div class="col-lg-5"><div class="table-card"><h2 class="h5">Đăng ký gần đây</h2>@foreach(var e in Model.RecentEnrollments){<div class="d-flex justify-content-between border-bottom py-2"><span>@e.Student.User.FullName<br><small class="text-secondary">@e.Class.ClassName</small></span><span class="badge-soft">@e.Status</span></div>}</div></div></div>
@section Scripts{<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script>new Chart(document.getElementById('chart'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels)),datasets:[{label:'Lượt đăng ký',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthValues)),backgroundColor:'#0754c9',borderRadius:8}]},options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}}});</script>}
