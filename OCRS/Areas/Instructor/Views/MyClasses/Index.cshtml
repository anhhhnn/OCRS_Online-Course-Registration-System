@model IEnumerable<CourseClass>
@{ViewData["Title"]="Lớp của tôi";}<h1>Lớp của tôi</h1><div class="table-card p-0 mt-4"><table class="table mb-0"><thead><tr><th>Lớp</th><th>Khóa học</th><th>Thời gian</th><th>Sĩ số</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ClassName</td><td>@x.Course.CourseName</td><td>@x.StartDate.ToString("dd/MM")–@x.EndDate.ToString("dd/MM/yyyy")</td><td>@x.CurrentEnrollment/@x.MaxCapacity</td><td><a href="/Instructor/MyClasses/Details/@x.ClassId" class="btn btn-sm btn-outline-primary">Chi tiết</a></td></tr>}</tbody></table></div>
